# .env.example  ->  copy to `.env`  (cp .env.example .env)
#
# `.env` is read by Docker Compose ITSELF and holds the database ADMIN credentials. They are used
# once, to create the database. They are never passed to the app (Playbook CFG-10).
# NEVER commit `.env` (it is in .gitignore and .dockerignore).
#
# Make a strong value with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=example
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=<generate-a-strong-value>
